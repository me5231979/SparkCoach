# Spark web (apps/web). Copy to .env.local for local development. Never commit real values.
# On Vercel (project spark-app) these are set in Settings → Environment Variables.

# Postgres (Neon via Vercel Marketplace). Pooled URL for the app, unpooled for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob, private store spark-app-blob (job aids, attachments).
BLOB_READ_WRITE_TOKEN=

# Matchlight-managed default AI provider. Per-org provider keys are stored by reference, not here.
ANTHROPIC_API_KEY=

# Sign-in (Phase 2): WorkOS AuthKit for Matchlight staff now, customer SSO/SCIM later.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
